<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and up: the system shows this splash while the browser starts. -->
    <style name="Browser" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:colorAccent">#FFE5484D</item>
        <item name="android:windowSplashScreenBackground">@color/canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
